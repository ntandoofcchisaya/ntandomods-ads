<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= ad.title %> — <%= site.name %></title>
  <meta property="og:title" content="<%= ad.title %>">
  <meta property="og:description" content="<%= ad.description.slice(0,150) %>">
  <meta property="og:image" content="<%= shareUrl %>/image.png">
  <meta property="og:image:width" content="1080">
  <meta property="og:image:height" content="1350">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="<%= shareUrl %>/image.png">
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container narrow">
    <% if (posted) { %>
      <div class="alert alert-success">Your ad is live! Share it below to get more responses.</div>
    <% } %>

    <a href="/" class="back-link">&larr; Back to all ads</a>

    <div class="ad-detail">
      <% if (ad.images && ad.images.length) { %>
        <div class="ad-gallery">
          <% ad.images.forEach(img => { %>
            <img src="<%= img %>" alt="<%= ad.title %>">
          <% }) %>
        </div>
      <% } %>

      <span class="ad-cat-badge"><%= ad.category %></span>
      <% if (ad.boostedUntil && new Date(ad.boostedUntil) > new Date()) { %>
        <span class="ad-boost-badge">&#128293; Boosted</span>
      <% } else if (ad.highlighted) { %>
        <span class="ad-highlight-badge">&#11088; Featured</span>
      <% } %>
      <h1><%= ad.title %></h1>
      <div class="ad-detail-price<%= ad.price ? '' : ' ad-price-request' %>"><%= displayPrice(ad) %></div>
      <div class="ad-detail-loc">📍 <%= displayLocation(ad) || 'Location not set' %> &middot; <%= ad.views %> views</div>

      <p class="ad-detail-desc"><%= ad.description %></p>

      <a class="btn btn-whatsapp btn-lg btn-block"
         href="https://wa.me/<%= ad.whatsapp %>?text=<%= encodeURIComponent('Hi, I saw your ad "' + ad.title + '" on ' + site.name + '. Is it still available?') %>"
         target="_blank" rel="noopener">
        💬 Chat on WhatsApp
      </a>

      <div class="share-image-preview">
        <img src="/ad/<%= ad.id %>/image.png" alt="Shareable image for <%= ad.title %>" loading="lazy">
      </div>

      <div class="share-section">
        <div class="share-label">Share this ad</div>
        <div class="share-buttons">
          <button class="share-btn share-native" id="nativeShareBtn" style="display:none;">📤 Share</button>
          <a class="share-btn share-image-dl" href="/ad/<%= ad.id %>/image.png" download="<%= ad.id %>.png">🖼️ Download Image</a>
          <a class="share-btn share-whatsapp" target="_blank" rel="noopener"
             href="https://wa.me/?text=<%= encodeURIComponent(ad.title + ' - ' + shareUrl) %>">WhatsApp</a>
          <a class="share-btn share-facebook" target="_blank" rel="noopener"
             href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>">Facebook</a>
          <a class="share-btn share-x" target="_blank" rel="noopener"
             href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(ad.title + ' — ' + (ad.price ? displayPrice(ad) + ' ' : '')) %>&url=<%= encodeURIComponent(shareUrl) %>">X / Twitter</a>
          <button class="share-btn share-instagram" id="instagramShareBtn">Instagram</button>
          <button class="share-btn share-copy" onclick="copyLink()">Copy Link</button>
        </div>
        <p class="share-hint">Tip: the image above includes a QR code buyers can scan straight to this ad — perfect for WhatsApp Status, Instagram Stories, or printing.</p>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    const shareUrl = "<%= shareUrl %>";
    const imageUrl = "<%= shareUrl %>/image.png";
    const shareTitle = "<%- ad.title.replace(/"/g, '\\\\"') %>";
    const shareCaption = shareTitle + " — " + shareUrl;

    function copyLink() {
      navigator.clipboard.writeText(shareUrl).then(() => {
        alert("Link copied! Paste it anywhere, including Instagram bio or DM.");
      });
    }

    async function fetchImageFile() {
      const res = await fetch(imageUrl);
      const blob = await res.blob();
      return new File([blob], "<%= ad.id %>.png", { type: "image/png" });
    }

    // Native mobile share sheet: shares the actual image file (not just a
    // link) when the browser supports the Web Share API with files
    // (most Android/iOS browsers). Falls back to link-only share, and the
    // button is hidden entirely on browsers with no share API at all.
    const nativeBtn = document.getElementById('nativeShareBtn');
    if (navigator.share) {
      nativeBtn.style.display = '';
      nativeBtn.addEventListener('click', async () => {
        try {
          const file = await fetchImageFile();
          const shareData = { title: shareTitle, text: shareCaption, url: shareUrl };
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            shareData.files = [file];
            delete shareData.url; // avoid duplicate link when sharing a file+text
          }
          await navigator.share(shareData);
        } catch (err) {
          if (err.name !== 'AbortError') {
            navigator.clipboard.writeText(shareUrl);
            alert('Could not open the share sheet, link copied instead.');
          }
        }
      });
    }

    // Instagram has no public web endpoint to prefill a post/story, so the
    // practical flow is: copy the caption, download the image, then the
    // user opens Instagram and shares/posts it manually (Stories accepts
    // 4:5 images from the camera roll perfectly).
    document.getElementById('instagramShareBtn').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(shareCaption);
      } catch (e) { /* clipboard may be unavailable, continue anyway */ }
      const a = document.createElement('a');
      a.href = imageUrl;
      a.download = "<%= ad.id %>.png";
      document.body.appendChild(a);
      a.click();
      a.remove();
      alert('Caption copied and image downloading. Open Instagram and share it to your Story or Feed!');
    });
  </script>
</body>
</html>
