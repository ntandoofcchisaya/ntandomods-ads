<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-badge">N</span>
      <span><%= site.name %></span>
    </a>
    <nav class="nav">
      <a href="/">Browse Ads</a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/rewards" class="stars-pill">&#11088; <%= currentUser.stars %></a>
      <% } else { %>
        <a href="/login">Log In</a>
      <% } %>
      <a href="/post" class="btn btn-post">+ Post Free Ad</a>
    </nav>
  </div>
</header>
